{
  "manifest_version": 3,
  "name": "CareerPilot AI - Review Fill",
  "version": "0.1.0",
  "description": "Candidate-controlled profile filling for tested Greenhouse forms.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["http://localhost:4000/*", "http://127.0.0.1:4000/*", "https://*.greenhouse.io/*"],
  "action": {
    "default_title": "CareerPilot AI",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.greenhouse.io/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
